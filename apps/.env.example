# Browser preview: pnpm dev (from the repository root).
# Direct LAN/VPN access: pnpm run dev --host 0.0.0.0
# Optional default bind address for the root development runner:
# DEV_HOST=0.0.0.0
WEB_PORT=5174
BACKEND_PORT=4318
# The server machine hostname is allowed automatically.
# Optional additional DNS/reverse-proxy hostname; SSH localhost forwarding needs no setting.
# PREVIEW_HOST=preview.example.com
# Desktop preview on your machine: pnpm dev:desktop --url=http://localhost:5174
# Desktop without --url loads the bundled UI after pnpm build:client.
# pnpm dev starts Laravel too; pnpm dev:client starts only the client preview.
