# Browser preview: npm run dev (from apps/). Forward only WEB_PORT over SSH.
WEB_PORT=5174
BACKEND_PORT=4318
# Optional reverse-proxy hostname; SSH localhost forwarding needs no setting.
# PREVIEW_HOST=preview.example.com
# Desktop preview on your machine: npm run dev:desktop -- --url=http://localhost:5174
# Desktop without --url loads the bundled UI after npm run build.
# The Laravel learning platform runs separately (e.g. php artisan serve).
