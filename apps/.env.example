# Browser preview: pnpm dev (from the repository root). Forward only WEB_PORT over SSH.
WEB_PORT=5174
BACKEND_PORT=4318
# Optional reverse-proxy hostname; SSH localhost forwarding needs no setting.
# PREVIEW_HOST=preview.example.com
# Desktop preview on your machine: pnpm dev:desktop --url=http://localhost:5174
# Desktop without --url loads the bundled UI after pnpm build:client.
# pnpm dev starts Laravel too; pnpm dev:client starts only the client preview.
