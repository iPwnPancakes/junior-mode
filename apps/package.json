{
    "name": "junior-mode-apps",
    "private": true,
    "type": "module",
    "workspaces": [
        "backend",
        "web",
        "desktop"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:web": "npm run dev --workspace @junior-mode/web",
        "dev:backend": "npm run dev --workspace @junior-mode/backend",
        "dev:desktop": "npm start --workspace junior-mode-desktop --",
        "setup:desktop": "node scripts/install-electron.mjs",
        "build": "npm run build --workspace @junior-mode/web",
        "build:desktop": "npm run build && npm run build --workspace junior-mode-desktop",
        "pack:desktop": "npm run build && npm run pack --workspace junior-mode-desktop",
        "test": "npm test --workspace @junior-mode/backend && npm test --workspace junior-mode-desktop",
        "test:electron": "node --test tests/electron.test.mjs",
        "typecheck": "npm run typecheck --workspace @junior-mode/web",
        "lint": "eslint ."
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.19.0",
        "eslint-plugin-react-hooks": "^7.0.0",
        "globals": "^15.14.0",
        "playwright": "^1.63.0",
        "typescript-eslint": "^8.23.0",
        "vite": "^8.0.0"
    }
}
