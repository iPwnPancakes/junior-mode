{
    "name": "junior-mode-desktop",
    "version": "0.1.0",
    "private": true,
    "description": "Junior Mode desktop client",
    "author": "Junior Mode",
    "type": "module",
    "main": "main.mjs",
    "scripts": {
        "start": "electron .",
        "test": "node --test tests/*.test.mjs",
        "pack": "electron-builder --dir",
        "build": "electron-builder"
    },
    "dependencies": {
        "@junior-mode/backend": "0.1.0"
    },
    "devDependencies": {
        "electron": "44.4.5",
        "electron-builder": "26.15.3"
    },
    "build": {
        "appId": "com.juniormode.desktop",
        "productName": "Junior Mode",
        "directories": {
            "output": "dist"
        },
        "files": [
            "*.mjs",
            "*.cjs",
            "renderer/**"
        ],
        "mac": {
            "target": [
                "dmg"
            ],
            "category": "public.app-category.education"
        },
        "win": {
            "target": [
                "nsis"
            ]
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Education"
        }
    }
}
